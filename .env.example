PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_INDEXABLE=false
# Generate a long random value for each environment. Do not commit real secrets.
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Enable only when intentionally sending to the verified Formspree recipient.
QUOTE_EMAIL_ENABLED=false

# First-party aggregate quote funnel counts; no third-party analytics scripts.
MEASUREMENT_ENABLED=false
